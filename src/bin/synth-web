#!/usr/bin/env python3
"""Independent factual web projection for a resolved SYNTH evidence surface."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import pathlib
import queue
import signal
import tempfile
import threading
import time
import urllib.request
from datetime import datetime, timezone
from http import HTTPStatus
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer


IDENTITY = "synth-web"
VERSION = "0.1.0"
ASSET_ROOT = pathlib.Path(__file__).resolve().parent.parent / "share" / "synth-web"


def now() -> str:
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def atomic_json(path: pathlib.Path, value: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix=path.name + ".", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            json.dump(value, stream, indent=2, sort_keys=True)
            stream.write("\n")
        os.replace(temporary, path)
    except BaseException:
        pathlib.Path(temporary).unlink(missing_ok=True)
        raise


def load_resolved_surface() -> tuple[dict, dict, bytes, pathlib.Path]:
    resolution_path = pathlib.Path(os.environ["SYNTH_RESOLVED_SURFACES_PATH"])
    resolution = json.loads(resolution_path.read_text(encoding="utf-8"))
    if resolution.get("epistemic_class") != "RESOLVED":
        raise RuntimeError("surface resolution is not RESOLVED")
    surface = next(item for item in resolution["surfaces"] if item["id"] == "synth.evidence")
    evidence_path = pathlib.Path(surface["locator"])
    evidence_bytes = evidence_path.read_bytes()
    evidence = json.loads(evidence_bytes)
    if evidence.get("identity") != "SYNTH" or evidence.get("epistemic_class") != "OBSERVED":
        raise RuntimeError("synth.evidence is not a factual SYNTH observation")
    return surface, evidence, evidence_bytes, evidence_path


class StateManager:
    def __init__(self, surface: dict, evidence: dict, evidence_bytes: bytes, evidence_path: pathlib.Path, endpoint: str | None = None, healthy: bool = True):
        self.surface = surface
        self.evidence = evidence
        self.evidence_bytes = evidence_bytes
        self.evidence_path = evidence_path
        self.evidence_sha256 = hashlib.sha256(evidence_bytes).hexdigest()
        self.loaded_at = now()
        self.endpoint = endpoint
        self.healthy = healthy
        self.lock = threading.Lock()
        self.subscribers: list[queue.Queue[str]] = []
        self._stopping = threading.Event()
        self._watcher_thread: threading.Thread | None = None

    def start_watcher(self) -> None:
        self._watcher_thread = threading.Thread(target=self._watch_loop, daemon=True)
        self._watcher_thread.start()

    def stop_watcher(self) -> None:
        self._stopping.set()
        if self._watcher_thread:
            self._watcher_thread.join(timeout=1.0)

    def subscribe(self) -> queue.Queue[str]:
        q: queue.Queue[str] = queue.Queue(maxsize=100)
        with self.lock:
            self.subscribers.append(q)
        return q

    def unsubscribe(self, q: queue.Queue[str]) -> None:
        with self.lock:
            if q in self.subscribers:
                self.subscribers.remove(q)

    def _broadcast(self, event_type: str, data: str) -> None:
        message = f"event: {event_type}\ndata: {data}\n\n"
        with self.lock:
            for q in list(self.subscribers):
                try:
                    q.put_nowait(message)
                except queue.Full:
                    pass

    def _update_witness(self) -> None:
        witness_path_str = os.environ.get("SYNTH_WITNESS_PATH")
        realization_id = os.environ.get("SYNTH_REALIZATION_ID")
        if not witness_path_str or not realization_id or not self.endpoint:
            return
        observed = now()
        witness = {
            "$schema": "urn:synth:schema:realization-witness:0.1.0",
            "schema_version": "0.1.0",
            "identity": IDENTITY,
            "version": VERSION,
            "realization_id": realization_id,
            "process": {"pid": os.getpid()},
            "provided_surfaces": [{
                "id": "synth-web.http",
                "owner": IDENTITY,
                "kind": "http",
                "locator": self.endpoint,
                "direction": "inbound",
                "media_type": "text/html",
                "observability": "runtime-witness",
                "metadata": "factual human projection of resolved SYNTH evidence",
            }],
            "consumed_surfaces": [{
                "id": self.surface["id"],
                "locator": self.surface["locator"],
                "observed_at": observed,
                "evidence_sha256": self.evidence_sha256,
            }],
            "readiness": {"status": "READY", "mechanism": "self-observed HTTP health", "checked_at": observed},
            "observed_at": observed,
        }
        atomic_json(pathlib.Path(witness_path_str), witness)

    def _watch_loop(self) -> None:
        while not self._stopping.is_set():
            time.sleep(0.2)
            try:
                if not self.evidence_path.is_file():
                    continue
                new_bytes = self.evidence_path.read_bytes()
                new_sha256 = hashlib.sha256(new_bytes).hexdigest()
                if new_sha256 == self.evidence_sha256:
                    continue
                new_evidence = json.loads(new_bytes)
                if new_evidence.get("identity") != "SYNTH" or new_evidence.get("epistemic_class") != "OBSERVED":
                    continue
                with self.lock:
                    self.evidence_bytes = new_bytes
                    self.evidence_sha256 = new_sha256
                    self.evidence = new_evidence
                    self.loaded_at = now()
                if self.healthy:
                    self._update_witness()
                self._broadcast("state_updated", json.dumps(self.evidence))
            except Exception:
                pass


STATE_MANAGER: StateManager | None = None


class FactualHandler(BaseHTTPRequestHandler):
    def log_message(self, *_: object) -> None:
        return

    def send_bytes(self, status: HTTPStatus, media_type: str, body: bytes) -> None:
        try:
            self.send_response(status)
            self.send_header("Content-Type", media_type)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)
        except (BrokenPipeError, ConnectionResetError):
            pass

    def do_GET(self) -> None:  # noqa: N802 - BaseHTTPRequestHandler protocol
        global STATE_MANAGER
        mgr = STATE_MANAGER
        if self.path == "/health":
            healthy = mgr.healthy if mgr else False
            status = HTTPStatus.OK if healthy else HTTPStatus.SERVICE_UNAVAILABLE
            payload = {"ready": healthy, "loaded_at": mgr.loaded_at if mgr else None}
            self.send_bytes(status, "application/json", json.dumps(payload).encode())
            return

        if self.path in {"/api/state", "/api/raw"}:
            if not mgr:
                self.send_bytes(HTTPStatus.SERVICE_UNAVAILABLE, "application/json", b"{}")
                return
            with mgr.lock:
                data = mgr.evidence
            self.send_bytes(HTTPStatus.OK, "application/json", json.dumps(data).encode())
            return

        if self.path == "/api/meta":
            if not mgr:
                self.send_bytes(HTTPStatus.SERVICE_UNAVAILABLE, "application/json", b"{}")
                return
            with mgr.lock:
                meta = {
                    "web_identity": IDENTITY,
                    "web_version": VERSION,
                    "realization_id": os.environ.get("SYNTH_REALIZATION_ID"),
                    "source_surface": mgr.surface["id"],
                    "source_locator": mgr.surface["locator"],
                    "source_digest": mgr.evidence_sha256,
                    "loaded_at": mgr.loaded_at,
                    "is_live": True,
                }
            self.send_bytes(HTTPStatus.OK, "application/json", json.dumps(meta).encode())
            return

        if self.path == "/api/events":
            if not mgr:
                self.send_bytes(HTTPStatus.SERVICE_UNAVAILABLE, "text/plain", b"Service unavailable\n")
                return
            self.send_response(HTTPStatus.OK)
            self.send_header("Content-Type", "text/event-stream")
            self.send_header("Cache-Control", "no-store, no-cache, must-revalidate")
            self.send_header("Connection", "keep-alive")
            self.send_header("Access-Control-Allow-Origin", "*")
            self.end_headers()
            
            sub_queue = mgr.subscribe()
            try:
                # Send initial connection event with current state
                with mgr.lock:
                    initial_state = json.dumps(mgr.evidence)
                self.wfile.write(f"event: ready\ndata: {initial_state}\n\n".encode("utf-8"))
                self.wfile.flush()

                while True:
                    try:
                        msg = sub_queue.get(timeout=15.0)
                        self.wfile.write(msg.encode("utf-8"))
                        self.wfile.flush()
                    except queue.Empty:
                        # Heartbeat ping
                        self.wfile.write(b": ping\n\n")
                        self.wfile.flush()
            except (BrokenPipeError, ConnectionResetError):
                pass
            finally:
                mgr.unsubscribe(sub_queue)
            return

        assets = {
            "/": "index.html",
            "/index.html": "index.html",
            "/styles.css": "styles.css",
            "/app.js": "app.js",
        }
        if self.path in assets:
            media = {
                "index.html": "text/html; charset=utf-8",
                "styles.css": "text/css; charset=utf-8",
                "app.js": "text/javascript; charset=utf-8",
            }
            name = assets[self.path]
            asset_path = ASSET_ROOT / name
            if asset_path.is_file():
                self.send_bytes(HTTPStatus.OK, media[name], asset_path.read_bytes())
                return

        self.send_bytes(HTTPStatus.NOT_FOUND, "text/plain", b"Not found\n")


def main() -> int:
    global STATE_MANAGER
    parser = argparse.ArgumentParser()
    parser.add_argument("--fail-readiness", action="store_true")
    options = parser.parse_args()

    surface, evidence, evidence_bytes, evidence_path = load_resolved_surface()
    server = ThreadingHTTPServer(("127.0.0.1", 0), FactualHandler)
    thread = threading.Thread(target=server.serve_forever, daemon=True)
    thread.start()
    endpoint = f"http://127.0.0.1:{server.server_port}"

    STATE_MANAGER = StateManager(
        surface=surface,
        evidence=evidence,
        evidence_bytes=evidence_bytes,
        evidence_path=evidence_path,
        endpoint=endpoint,
        healthy=not options.fail_readiness,
    )
    STATE_MANAGER.start_watcher()

    stopping = threading.Event()
    signal.signal(signal.SIGTERM, lambda *_: stopping.set())
    signal.signal(signal.SIGINT, lambda *_: stopping.set())

    if not options.fail_readiness:
        with urllib.request.urlopen(endpoint + "/health", timeout=1) as response:
            if response.status != HTTPStatus.OK:
                raise RuntimeError("self-observed readiness failed")
        STATE_MANAGER._update_witness()

    stopping.wait()
    STATE_MANAGER.stop_watcher()
    server.shutdown()
    thread.join(timeout=2)
    server.server_close()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
